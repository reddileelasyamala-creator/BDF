{
  "info": {
    "name": "Lab 03 - Book Management RESTful API",
    "_postman_id": "lab03-book-api-collection",
    "description": "Postman Collection for Lab 03 - RESTful API Development, Query Parameters, Validation and Debugging.\nStudent: Reddi Leela Syamala (252U1R3078)",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. GET All Books",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""]
        }
      }
    },
    {
      "name": "2. GET Book by ID (Valid - 200 OK)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/1/",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", "1", ""]
        }
      }
    },
    {
      "name": "3. Search Books (search_q=George)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?search_q=George",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "search_q",
              "value": "George"
            }
          ]
        }
      }
    },
    {
      "name": "4. Sort Books (order_by=price & order=desc)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?order_by=price&order=desc",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "desc"
            }
          ]
        }
      }
    },
    {
      "name": "5. Pagination (limit=3 & offset=2)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?limit=3&offset=2",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "offset",
              "value": "2"
            }
          ]
        }
      }
    },
    {
      "name": "6. Price Filter (min_price=300 & max_price=450)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?min_price=300&max_price=450",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "min_price",
              "value": "300"
            },
            {
              "key": "max_price",
              "value": "450"
            }
          ]
        }
      }
    },
    {
      "name": "7. Combined Query (search + sort + filter + pagination)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "http://localhost:3000/books/?search_q=the&order_by=price&order=asc&min_price=200&max_price=500&limit=3&offset=0",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["books", ""],
          "query": [
            {
              "key": "search_q",
              "value": "the"
            },
            {
              "key": "order_by",
              "value": "price"
            },
            {
              "key": "order",
              "value": "asc"
            },
            {
              "key": "min_price",
              "value": "200"
            },
            {
              "key": "max_price",
              "value": "500"
            },
            {
              "key": "limit",
              "value": "3"
            },
            {
              "key": "offset",
              "value": "0"
            }
          ]
        }
      }
    },
