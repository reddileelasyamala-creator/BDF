  "item": [
    {
      "name": "Registration",
      "item": [
        {
          "name": "1. Register a valid new user - 201 Created",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"leela123\",\n  \"name\": \"Leela Syamala\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/register/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["register", ""]
            },
            "description": "Registers a new user with valid username, name, and password. Password is automatically hashed using bcrypt."
          }
        },
        {
          "name": "2. Register the same username again - 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"leela123\",\n  \"name\": \"Leela Syamala\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/register/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["register", ""]
            },
            "description": "Rejects registration when attempting to register an already existing username."
          }
        },
        {
          "name": "3. Register with missing username - 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Leela Syamala\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/register/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["register", ""]
            },
            "description": "Validates request payload and rejects registration with missing username."
          }
        },
        {
          "name": "4. Register with missing name - 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"leela456\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/register/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["register", ""]
            },
            "description": "Validates request payload and rejects registration with missing name."
          }
        },
        {
          "name": "5. Register with missing password - 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
