      ]
    },
    {
      "name": "Login",
      "item": [
        {
          "name": "6. Login with correct username and password - 200 OK",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"leela123\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/login/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["login", ""]
            },
            "description": "Verifies correct credentials with bcrypt.compare() and returns a signed JWT token."
          }
        },
        {
          "name": "7. Login with an unknown username - 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"unknownuser999\",\n  \"password\": \"SecurePass123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/login/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["login", ""]
            },
            "description": "Rejects login attempt when the username does not exist in SQLite database."
          }
        },
        {
          "name": "8. Login with an incorrect password - 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"leela123\",\n  \"password\": \"WrongPassword999\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/login/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["login", ""]
            },
            "description": "Rejects login attempt when supplied password does not match stored bcrypt hash."
          }
        },
        {
          "name": "9. Login with missing credentials - 400 Bad Request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"leela123\"\n}"
            },
            "url": {
              "raw": "http://localhost:3000/login/",
              "protocol": "http",
              "host": ["localhost"],
              "port": "3000",
              "path": ["login", ""]
            },
            "description": "Rejects login request when required fields are missing from request body."
